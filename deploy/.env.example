# Copy to deploy/.env on the server and fill in. deploy/.env is never committed.

# The domain this server answers for. Its DNS A record must point here.
KHAPEE_DOMAIN=khapee.com
KHAPEE_ORIGIN=https://khapee.com

# Copy this from Render → the khapee service → Environment → KHAPEE_SECRET.
# The same value keeps everybody signed in AND keeps the push keys the same, so
# every phone already signed up for order alerts carries on working. A new
# value signs everybody out and every phone has to switch alerts on again.
KHAPEE_SECRET=

# Accounts whose phone rings for every restaurant (comma-separated emails).
KHAPEE_OWNER_EMAILS=

# Order emails — a second channel beside push. Gmail with an app password:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
